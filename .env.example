# Firebase Web App configuration
# Get these from: Firebase Console > Project Settings > General > Your apps > SDK setup and configuration
# These are safe to expose in the browser (that's what NEXT_PUBLIC_ means) — they identify
# your Firebase project, they are not secret keys.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Base URL used to build referral links and the email-verification action
# link (e.g. https://cocarewards.com) — must also be added to Firebase
# Console > Authentication > Settings > Authorized domains in production.
# Falls back to Vercel's auto-exposed URL, then localhost, if unset.
NEXT_PUBLIC_SITE_URL=

# Firebase Admin SDK (server-only — NEVER prefix these with NEXT_PUBLIC_).
# Required only for Admin User Management's Permanent Delete feature,
# which needs to remove a Firebase Authentication account server-side (the
# client SDK can never delete anyone but the currently signed-in user).
# Get these from: Firebase Console > Project Settings > Service Accounts >
# Generate new private key (downloads a JSON file — never commit it).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# The downloaded JSON's "private_key" field, base64-encoded ONCE before
# pasting here (avoids newline-escaping problems with multi-line PEM keys
# in a single env var): node -e "console.log(Buffer.from(require('./service-account.json').private_key).toString('base64'))"
FIREBASE_ADMIN_PRIVATE_KEY_BASE64=
