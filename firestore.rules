rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // The only source of truth for "is this caller an admin" — role lives on
    // the requester's own Firestore profile, which is frozen from every
    // client write (see users/{uid} below), so a compromised/malicious
    // client can never grant itself this by writing its own document.
    function isAdmin() {
      return isSignedIn() && userData(request.auth.uid).role == "admin";
    }

    // Suspended/archived/banned accounts are blocked from every self-service
    // financial write (deposits, withdrawals, task submissions, daily
    // claims) — this is the real enforcement of Suspend/Archive, not just a
    // hidden button in the admin UI. Deliberately does NOT block reads: a
    // suspended/archived user's own client still needs to read their own
    // profile to show the "account suspended" screen.
    function isActiveAccount(uid) {
      return userData(uid).accountStatus == "active";
    }

    function isValidPackageRef(pkg) {
      return pkg == null || exists(/databases/$(database)/documents/packages/$(pkg));
    }

    // Shared baseline for both tasks and bonus tiers. Packages never
    // expire, and — deliberately — disabling a package (isActive: false)
    // never affects a holder who already owns it: isActive only blocks NEW
    // purchases, enforced separately at deposit-creation time (see
    // deposits/{id} below). An existing holder's own eligibility only ever
    // depends on still HOLDING a package, not on its current isActive flag.
    function userHasQualifyingPackage(uid) {
      let user = userData(uid);
      return user.package != null
        && exists(/databases/$(database)/documents/packages/$(user.package));
    }

    // A task's own two (mutually exclusive) package gates on top of the
    // qualifying-package baseline above: an exact required package, or a
    // minimum package price (packages have no separate tier/level field, so
    // price is the platform's existing proxy for rank).
    function taskEligible(uid, taskId) {
      let user = userData(uid);
      let task = get(/databases/$(database)/documents/tasks/$(taskId)).data;
      return user.accountStatus == "active"
        && userHasQualifyingPackage(uid)
        && (task.requiredPackageId == null || user.package == task.requiredPackageId)
        && (task.minPackagePrice == null
            || get(/databases/$(database)/documents/packages/$(user.package)).data.price >= task.minPackagePrice);
    }

    // A bonus tier's package gate — exact match only (Milestone 12 asked for
    // a single "required package", not a minimum-price variant like tasks).
    function bonusPackageEligible(uid, tierId) {
      let user = userData(uid);
      let tier = get(/databases/$(database)/documents/bonusTiers/$(tierId)).data;
      return tier.requiredPackageId == null || user.package == tier.requiredPackageId;
    }

    // Absence of settings/global means daily claims are ON by default — the
    // feature works out of the box without requiring an admin to explicitly
    // enable it first.
    function dailyClaimsGloballyEnabled() {
      return !exists(/databases/$(database)/documents/settings/global)
        || get(/databases/$(database)/documents/settings/global).data.dailyClaimsEnabled == true;
    }

    function dailyEarningFor(pkg) {
      return get(/databases/$(database)/documents/packages/$(pkg)).data.dailyEarning;
    }

    // Prefers this holder's own snapshotted rate (set at the approval that
    // granted them their package — see approveDeposit) over the package's
    // current live rate, so a later admin edit to the template never
    // retroactively changes what an existing holder earns. Falls back to
    // the live rate only for accounts approved before this snapshot field
    // existed.
    function effectiveDailyEarning(user) {
      return user.get("packageDailyEarning", null) != null
        ? user.packageDailyEarning
        : dailyEarningFor(user.package);
    }

    // Same "holder's own snapshot, live value as fallback" convention as
    // effectiveDailyEarning, for the daily ad-task quota instead of the
    // earning rate.
    function effectiveDailyTaskLimit(user) {
      return user.get("packageDailyTaskLimit", null) != null
        ? user.packageDailyTaskLimit
        : get(/databases/$(database)/documents/packages/$(user.package)).data.dailyTaskLimit;
    }

    // Admin-editable flat reward paid per completed ad-watch task
    // (settings/taskRewards) — absence of the document falls back to the
    // platform default of Rs 5, same graceful-default convention as
    // currentBalanceMinWithdraw() below. Read live at claim time, never
    // copied onto a task or user document, so a reward change takes effect
    // immediately for every existing and future task.
    function taskRewardPerAd() {
      return !exists(/databases/$(database)/documents/settings/taskRewards)
        ? 5
        : get(/databases/$(database)/documents/settings/taskRewards).data.rewardPerAd;
    }

    // True once this user has completed at least `requiredCount` distinct
    // tasks TODAY (a real UTC calendar day — the same boundary
    // canClaimDaily/isNewUtcDay use). `progress` is dailyTaskProgress/{uid}'s
    // data, fetched once by the caller via a single get() and passed in here
    // — never re-fetched — to keep each write's total document-access count
    // low. Independently maintained by taskCompletions' own create/update
    // rules (see those match blocks) — this function never trusts
    // taskRotations/{uid}'s self-reported arrays for anything financial.
    function dailyTaskQuotaMetFromDoc(progress, requiredCount) {
      return !isNewUtcDay(progress.windowStartAt, request.time) && progress.count >= requiredCount;
    }

    // Admin-editable minimum a Current Balance withdrawal request must meet
    // (settings/withdrawalRules) — absence of the document falls back to the
    // platform default of Rs 500. The Coca-Cola Earning path's own gate
    // (direct-active-referral Level) isn't computable in rules at all (no
    // aggregate queries here), so it has no equivalent helper — see the
    // withdrawals/{id} create rule's comment.
    function currentBalanceMinWithdraw() {
      return !exists(/databases/$(database)/documents/settings/withdrawalRules)
        ? 500
        : get(/databases/$(database)/documents/settings/withdrawalRules).data.currentBalanceMinWithdraw;
    }

    // True once `now` falls on a later UTC calendar date than `prev` —
    // compared explicitly by year/month/day (not by elapsed duration), so a
    // package activated at 23:59 UTC becomes eligible for its first credit
    // one second later at 00:00 UTC, not a full 24h afterward. Firestore
    // timestamps are always UTC, so "00:00 server time" and "00:00 UTC" are
    // the same instant here.
    function isNewUtcDay(prev, now) {
      return now.year() > prev.year()
        || (now.year() == prev.year() && now.month() > prev.month())
        || (now.year() == prev.year() && now.month() == prev.month() && now.day() > prev.day());
    }

    // `user` is an already-resolved users/{uid} data map (either `resource.data`
    // when called from within the users/{uid} rule itself, or `userData(uid)`
    // when called from a sibling collection's rule) — never re-fetched here,
    // so this works identically in both places. The anti-replay gate is a
    // real UTC calendar-day boundary (see isNewUtcDay), not a rolling 24h
    // window — a package's daily earning becomes claimable once at the
    // start of every new UTC day it's active for, never twice on the same
    // day, matching "credits once per day starting the day after
    // activation" exactly (lastDailyClaimAt is seeded to activatedAt at
    // activation time, see approveDeposit). Packages never expire, and
    // disabling a package (isActive: false) never affects a holder who
    // already owns it — isActive only blocks NEW purchases, enforced
    // separately at deposit-creation time.
    function canClaimDaily(user) {
      return dailyClaimsGloballyEnabled()
        && user.accountStatus == "active"
        && user.package != null
        && exists(/databases/$(database)/documents/packages/$(user.package))
        && (user.lastDailyClaimAt == null || isNewUtcDay(user.lastDailyClaimAt, request.time));
    }

    // The owner path: a plain profile edit (e.g. a Settings-page profile/
    // preference change) may only ever touch these fields — every money/
    // role/status/package/referral-count field is frozen by omission,
    // including any added after this rule was written, since affectedKeys()
    // must be a subset of exactly this list. `referredBy` is deliberately
    // absent (Milestone 11): it's set once at creation and frozen forever
    // after, so a user can never retroactively reassign who referred them
    // to redirect a future package purchase's referral chain to an
    // accomplice. `emailVerified` is also absent — there is no email
    // verification flow, so no client ever needs to write it.
    function ownerCanUpdateUser() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          "fullName", "fullNameLower", "email", "referralCode",
          "notificationsEnabled", "themePreference", "languagePreference", "updatedAt"
        ])
        && (!("notificationsEnabled" in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.notificationsEnabled is bool)
        && (!("themePreference" in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.themePreference in ["dark", "light", "system"])
        && (!("languagePreference" in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.languagePreference in ["en", "ur"]);
    }

    // The self-service bundled daily-reward claim path — replaces the old
    // automatic-only package-earning claim entirely: package earning is no
    // longer credited on its own, only together with the flat per-ad task
    // reward, once every one of today's assigned tasks is genuinely
    // complete (dailyTaskQuotaMet). Reuses the exact same UTC-calendar-day
    // idempotency anchor (lastDailyClaimAt/isNewUtcDay) the retired
    // automatic path already relied on, so a double-click/refresh/two-tab
    // race is closed by the same proven mechanism, not a new one.
    function ownerCanClaimDailyTaskReward(uid) {
      let user = resource.data;
      let requiredCount = effectiveDailyTaskLimit(user);
      let taskReward = requiredCount * taskRewardPerAd();
      let packageEarning = effectiveDailyEarning(user);
      let progress = get(/databases/$(database)/documents/dailyTaskProgress/$(uid)).data;
      return canClaimDaily(user)
        && dailyTaskQuotaMetFromDoc(progress, requiredCount)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["currentBalance", "cocaColaEarning", "totalEarnings", "todayEarnings", "lastDailyClaimAt", "updatedAt"])
        && request.resource.data.lastDailyClaimAt == request.time
        && request.resource.data.currentBalance == resource.data.currentBalance + taskReward
        && request.resource.data.cocaColaEarning == resource.data.cocaColaEarning + packageEarning
        && request.resource.data.totalEarnings == resource.data.totalEarnings + taskReward + packageEarning
        && request.resource.data.todayEarnings == taskReward + packageEarning;
    }

    // The self-service "I'm submitting a package-purchase deposit" marker —
    // the only field this path may touch, and only settable while nothing
    // else is already pending (no client can ever mark a second one
    // pending, since the precondition reads the value BEFORE this write).
    function ownerCanMarkPendingPurchase() {
      return resource.data.pendingPackagePurchaseId == null
        && request.resource.data.pendingPackagePurchaseId is string
        && request.resource.data.pendingPackagePurchaseId.size() > 0
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["pendingPackagePurchaseId", "updatedAt"]);
    }

    // Same one-pending-request-per-wallet pattern as ownerCanMarkPendingPurchase
    // above, but for withdrawals — exactly one of the two marker fields may
    // be set per write (never both at once, since a single withdrawal
    // request only ever targets one wallet), and only while that specific
    // field is still null.
    function ownerCanMarkPendingWithdrawal() {
      return (
        (resource.data.pendingWithdrawalCurrentBalance == null
          && request.resource.data.pendingWithdrawalCurrentBalance is string
          && request.resource.data.pendingWithdrawalCurrentBalance.size() > 0
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["pendingWithdrawalCurrentBalance", "updatedAt"]))
        || (resource.data.pendingWithdrawalCocaColaEarning == null
          && request.resource.data.pendingWithdrawalCocaColaEarning is string
          && request.resource.data.pendingWithdrawalCocaColaEarning.size() > 0
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["pendingWithdrawalCocaColaEarning", "updatedAt"]))
      );
    }

    // Mirrors ownerCanClaimDailyTaskReward() for the wallets/{uid} document
    // — reads the user's package/quota via userData(uid) since
    // wallets/{uid} itself doesn't store those fields. Both writes happen
    // in the same client transaction as the users/{uid} update above, and
    // both are independently gated the same way, so neither can be written
    // alone by a client skipping the other.
    function ownerCanClaimDailyTaskRewardWallet(uid) {
      let user = userData(uid);
      let requiredCount = effectiveDailyTaskLimit(user);
      let taskReward = requiredCount * taskRewardPerAd();
      let packageEarning = effectiveDailyEarning(user);
      let progress = get(/databases/$(database)/documents/dailyTaskProgress/$(uid)).data;
      return canClaimDaily(user)
        && dailyTaskQuotaMetFromDoc(progress, requiredCount)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["currentBalance", "cocaColaEarning", "totalEarnings", "updatedAt"])
        && request.resource.data.currentBalance == resource.data.currentBalance + taskReward
        && request.resource.data.cocaColaEarning == resource.data.cocaColaEarning + packageEarning
        && request.resource.data.totalEarnings == resource.data.totalEarnings + taskReward + packageEarning;
    }

    // The admin path: deliberately narrower than "admin can do anything".
    // Admin may only ever move money fields (never below 0), flip
    // accountStatus, reassign package and its lifecycle dates, or clear the
    // pending-purchase marker — every identity/profile field (including
    // role itself) stays frozen even for an admin write, so a compromised
    // admin session can't rewrite who a user is or mint more admins. Role
    // escalation is intentionally impossible through the app; the first
    // admin is bootstrapped by hand in the Firebase console. Exact
    // activation/expiry arithmetic isn't independently re-derived here
    // (Firestore rules can't verify serverTimestamp() + N days against a
    // client-supplied value without either exact-equality clock-skew
    // fragility or a wide tolerance window) — admin-computed values get
    // type/ordering sanity checks only, consistent with how admin-approved
    // wallet credits are already trusted elsewhere in this file.
    function adminCanUpdateUser() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "walletBalance", "currentBalance", "cocaColaEarning", "staffEarning",
        "totalEarnings", "pendingEarnings", "todayEarnings",
        "accountStatus", "package", "packagePurchasedAt", "packageActivatedAt",
        "packageExpiresAt", "packageDailyEarning", "packageDailyTaskLimit",
        "pendingPackagePurchaseId", "lastDailyClaimAt",
        "pendingWithdrawalCurrentBalance", "pendingWithdrawalCocaColaEarning", "updatedAt"
      ])
        && request.resource.data.walletBalance is number && request.resource.data.walletBalance >= 0
        && request.resource.data.currentBalance is number && request.resource.data.currentBalance >= 0
        && request.resource.data.cocaColaEarning is number && request.resource.data.cocaColaEarning >= 0
        && request.resource.data.staffEarning is number && request.resource.data.staffEarning >= 0
        && request.resource.data.totalEarnings is number && request.resource.data.totalEarnings >= 0
        && request.resource.data.pendingEarnings is number && request.resource.data.pendingEarnings >= 0
        && request.resource.data.todayEarnings is number && request.resource.data.todayEarnings >= 0
        && request.resource.data.accountStatus in ["active", "suspended", "archived", "banned"]
        && isValidPackageRef(request.resource.data.package)
        && (request.resource.data.packagePurchasedAt == null || request.resource.data.packagePurchasedAt is timestamp)
        && (request.resource.data.packageActivatedAt == null || request.resource.data.packageActivatedAt is timestamp)
        && (request.resource.data.packageExpiresAt == null || request.resource.data.packageExpiresAt is timestamp)
        && (request.resource.data.packageDailyEarning == null || request.resource.data.packageDailyEarning is number)
        && (request.resource.data.packageDailyTaskLimit == null || request.resource.data.packageDailyTaskLimit is number)
        && (request.resource.data.pendingPackagePurchaseId == null || request.resource.data.pendingPackagePurchaseId is string)
        && (request.resource.data.lastDailyClaimAt == null || request.resource.data.lastDailyClaimAt is timestamp)
        && (request.resource.data.pendingWithdrawalCurrentBalance == null || request.resource.data.pendingWithdrawalCurrentBalance is string)
        && (request.resource.data.pendingWithdrawalCocaColaEarning == null || request.resource.data.pendingWithdrawalCocaColaEarning is string);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.walletBalance == 0
        && request.resource.data.currentBalance == 0
        && request.resource.data.cocaColaEarning == 0
        && request.resource.data.staffEarning == 0
        && request.resource.data.totalEarnings == 0
        && request.resource.data.pendingEarnings == 0
        && request.resource.data.todayEarnings == 0
        && request.resource.data.totalReferrals == 0
        && request.resource.data.activeReferrals == 0
        && request.resource.data.package == null
        && request.resource.data.packagePurchasedAt == null
        && request.resource.data.packageActivatedAt == null
        && request.resource.data.packageExpiresAt == null
        && request.resource.data.packageDailyEarning == null
        && request.resource.data.packageDailyTaskLimit == null
        && request.resource.data.pendingPackagePurchaseId == null
        && request.resource.data.pendingWithdrawalCurrentBalance == null
        && request.resource.data.pendingWithdrawalCocaColaEarning == null
        && request.resource.data.lastDailyClaimAt == null
        && request.resource.data.notificationsEnabled == true
        && request.resource.data.themePreference == "dark"
        && request.resource.data.languagePreference == "en"
        && request.resource.data.role == "user"
        && request.resource.data.accountStatus == "active";
      allow update: if (isOwner(uid) && ownerCanUpdateUser())
        || (isAdmin() && adminCanUpdateUser())
        || (isOwner(uid) && ownerCanClaimDailyTaskReward(uid))
        || (isOwner(uid) && ownerCanMarkPendingPurchase())
        || (isOwner(uid) && ownerCanMarkPendingWithdrawal());
      allow delete: if false;
    }

    match /wallets/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.balance == 0
        && request.resource.data.currentBalance == 0
        && request.resource.data.cocaColaEarning == 0
        && request.resource.data.staffEarning == 0
        && request.resource.data.totalEarnings == 0
        && request.resource.data.pendingEarnings == 0;
      // Kept in sync with users/{uid}'s denormalized copy by the same admin
      // transaction that approves a deposit/withdrawal, or by the caller's
      // own daily-claim transaction — never a plain client write, and never
      // allowed to go negative.
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 "balance", "currentBalance", "cocaColaEarning", "staffEarning",
                 "totalEarnings", "pendingEarnings", "updatedAt"
               ])
          && request.resource.data.balance is number && request.resource.data.balance >= 0
          && request.resource.data.currentBalance is number && request.resource.data.currentBalance >= 0
          && request.resource.data.cocaColaEarning is number && request.resource.data.cocaColaEarning >= 0
          && request.resource.data.staffEarning is number && request.resource.data.staffEarning >= 0
          && request.resource.data.totalEarnings is number && request.resource.data.totalEarnings >= 0
          && request.resource.data.pendingEarnings is number && request.resource.data.pendingEarnings >= 0)
        || (isOwner(uid) && ownerCanClaimDailyTaskRewardWallet(uid));
      allow delete: if false;
    }

    // Keyed by the code itself. Public `get` is required so a referral link
    // can be resolved to a uid during signup without exposing full profiles;
    // `list` stays closed so the whole collection can't be scraped.
    // `ancestorChain` is self-reported by the owner (copied from whatever
    // code they themselves signed up under) — trusted for team-page display
    // only, never for money: real referral rewards are computed from the
    // immutable users/{uid}.referredBy chain, not this field. See
    // team-members.ts's trust-boundary note for the full reasoning.
    match /referralCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ancestorChain is list
        && request.resource.data.ancestorChain.size() <= 11;
      allow update, delete: if false;
    }

    // An append-only ledger. An admin-run approval transaction may add an
    // entry for any type (a real, already-approved money movement); a
    // signed-in user may additionally add only their own "daily_reward"
    // entry, and only alongside a valid claim (amount pinned to their
    // current package's rate, cooldown enforced by canClaimDaily). Once
    // written, a transaction record is permanent — not even an admin can
    // edit or delete history.
    match /transactions/{id} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if (isAdmin()
          && request.resource.data.uid is string
          && request.resource.data.userName is string
          && request.resource.data.type in ["deposit", "withdrawal", "referral_reward", "daily_reward", "package_purchase", "task_reward", "bonus_reward", "admin_adjustment"]
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && request.resource.data.status in ["pending", "completed", "failed"]
          && request.resource.data.description is string
          && (request.resource.data.wallet == null || request.resource.data.wallet in ["walletBalance", "currentBalance", "cocaColaEarning", "staffEarning"])
          && (request.resource.data.referenceId == null || request.resource.data.referenceId is string)
          && (!("direction" in request.resource.data) || request.resource.data.direction in ["in", "out"]))
        || (isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.userName is string
          && request.resource.data.status == "completed"
          && request.resource.data.description is string
          && request.resource.data.referenceId is string
          // Both ledger entries the bundled daily-task-reward claim writes for
          // itself — see claimDailyTaskReward — share the same eligibility
          // gate (a valid, quota-met, not-yet-claimed-today state), each
          // pinned to its own wallet/amount formula so neither can be forged
          // independently of the other.
          && canClaimDaily(userData(request.auth.uid))
          && dailyTaskQuotaMetFromDoc(
               get(/databases/$(database)/documents/dailyTaskProgress/$(request.auth.uid)).data,
               effectiveDailyTaskLimit(userData(request.auth.uid))
             )
          && (
               (request.resource.data.type == "daily_reward"
                 && request.resource.data.wallet == "cocaColaEarning"
                 && request.resource.data.amount == effectiveDailyEarning(userData(request.auth.uid)))
               || (request.resource.data.type == "task_reward"
                 && request.resource.data.wallet == "currentBalance"
                 && request.resource.data.amount == effectiveDailyTaskLimit(userData(request.auth.uid)) * taskRewardPerAd())
             ));
      allow update, delete: if false;
    }

    function adminCanReviewRequest() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "reviewedBy", "reviewNote", "updatedAt"])
        && resource.data.status == "pending"
        && request.resource.data.status in ["approved", "rejected"]
        && request.resource.data.reviewedBy == request.auth.uid
        && (!("reviewNote" in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.reviewNote == null
            || request.resource.data.reviewNote is string);
    }

    // Permanent, admin-only removal of ONLY a deposit's screenshot payload —
    // every financial/audit field (amount, status, reviewedBy, packageId,
    // createdAt, etc.) is frozen by omission from the allowed-keys list, so
    // this can never be used to alter anything but the screenshot itself.
    // Re-checks resource.data.screenshotStatus == "available" server-side —
    // the real duplicate-deletion guard, independent of the UI hiding the
    // button once deleted. Stamps the four audit fields to exact,
    // non-forgeable values (admin's own uid, server time, a fixed reason
    // string) — a client can never backdate, misattribute, or invent a
    // different reason for a deletion.
    function adminCanDeleteScreenshot() {
      return resource.data.screenshotStatus == "available"
        && resource.data.screenshotUrl != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["screenshotUrl", "screenshotStatus", "screenshotDeletedAt", "screenshotDeletedBy", "screenshotDeletionReason", "updatedAt"])
        && request.resource.data.screenshotUrl == null
        && request.resource.data.screenshotStatus == "deleted"
        && request.resource.data.screenshotDeletedAt == request.time
        && request.resource.data.screenshotDeletedBy == request.auth.uid
        && request.resource.data.screenshotDeletionReason == "admin_manual_cleanup";
    }

    // Users may only ever create their own deposit request, always starting
    // "pending" with no reviewer. A plain top-up must fall within the
    // generic Rs 500–100,000 range; a package-purchase deposit instead must
    // exactly match that package's own price (whatever it is, however far
    // outside the generic range), target only an active package, and can
    // only be created while the requester has no other package purchase
    // already awaiting review. An admin may only flip a pending request to
    // approved/rejected and stamp themselves as reviewer — every other
    // field, including the amount, can never change post-submission, by
    // anyone.
    match /deposits/{id} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isActiveAccount(request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.status == "pending"
        && request.resource.data.reviewedBy == null
        && request.resource.data.method == "easypaisa"
        && request.resource.data.amount is number
        && request.resource.data.referenceId is string
        && request.resource.data.referenceId.size() > 0
        && request.resource.data.senderAccountNumber is string
        && request.resource.data.senderAccountNumber.size() > 0
        // Screenshot is optional (null == none attached). When present, it
        // must be a data-URL string under a hard 450KB safety ceiling —
        // generous headroom over the ~410KB a legitimately-compressed
        // 300KB image encodes to, so it never blocks a real upload, but it
        // still bounds a hand-crafted request well clear of Firestore's
        // 1MiB document limit. The MIME prefix is also independently
        // re-checked here against the same JPEG/PNG/WebP allowlist the
        // client enforces (payment-screenshots.ts) — a hand-crafted direct
        // SDK write can never smuggle in a different content type just
        // because it fits under the size cap. screenshotStatus must
        // consistently reflect whether a screenshot was actually attached,
        // and none of the admin-only deletion-audit fields may be pre-set
        // by the submitter.
        && (
             (request.resource.data.screenshotUrl == null
               && request.resource.data.screenshotStatus == null
               && request.resource.data.screenshotSizeBytes == null)
             || (request.resource.data.screenshotUrl is string
               && request.resource.data.screenshotUrl.size() < 450000
               && request.resource.data.screenshotUrl.matches('^data:image/(jpeg|png|webp);base64,.*')
               && request.resource.data.screenshotStatus == "available"
               && request.resource.data.screenshotSizeBytes is number
               && request.resource.data.screenshotSizeBytes > 0)
           )
        && request.resource.data.screenshotDeletedAt == null
        && request.resource.data.screenshotDeletedBy == null
        && request.resource.data.screenshotDeletionReason == null
        && isValidPackageRef(request.resource.data.packageId)
        && (
             (request.resource.data.packageId == null
               && request.resource.data.amount >= 500
               && request.resource.data.amount <= 100000)
             || (request.resource.data.packageId != null
               && get(/databases/$(database)/documents/packages/$(request.resource.data.packageId)).data.isActive == true
               && request.resource.data.amount == get(/databases/$(database)/documents/packages/$(request.resource.data.packageId)).data.price
               && userData(request.auth.uid).pendingPackagePurchaseId == null)
           );
      allow update: if isAdmin() && (adminCanReviewRequest() || adminCanDeleteScreenshot());
      allow delete: if false;
    }

    // Same shape as deposits, plus: amount can never exceed the requester's
    // relevant wallet balance. Which wallet/minimum applies depends on
    // sourceWallet — Staff Earning has no withdrawal path at all (not a
    // valid value here). There is no per-package withdrawal limit — only
    // the global settings/withdrawalRules minimums apply. Note: the
    // Coca-Cola Earning path's required-Level gate (direct active referral
    // count) can't be checked here — Firestore rules cannot run the
    // aggregate count query it needs — so it's only advisory client-side
    // UX; the authoritative check happens in approveWithdrawal via a live
    // getDirectActiveReferralCount() re-fetch before any money moves,
    // exactly like approveBonusClaim's team-aggregate re-check.
    match /withdrawals/{id} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isActiveAccount(request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.status == "pending"
        && request.resource.data.reviewedBy == null
        && request.resource.data.method == "easypaisa"
        && request.resource.data.amount is number
        && request.resource.data.accountName is string
        && request.resource.data.accountName.size() > 0
        && request.resource.data.accountNumber is string
        && request.resource.data.accountNumber.size() > 0
        && (
             (request.resource.data.sourceWallet == "current_balance"
               && request.resource.data.amount >= currentBalanceMinWithdraw()
               && request.resource.data.amount <= userData(request.auth.uid).currentBalance
               && userData(request.auth.uid).pendingWithdrawalCurrentBalance == null)
             || (request.resource.data.sourceWallet == "coca_cola_earning"
               && request.resource.data.amount >= 500
               && request.resource.data.amount <= userData(request.auth.uid).cocaColaEarning
               && userData(request.auth.uid).pendingWithdrawalCocaColaEarning == null)
           );
      allow update: if isAdmin() && adminCanReviewRequest();
      allow delete: if false;
    }

    // Granted only by the admin-run deposit-approval transaction, up to once
    // per depositId — the doc id itself is deterministic (the depositId, so
    // a retried transaction can never double this write), and it's never a
    // client write. A flat commission paid ONLY to the purchaser's direct
    // referrer (never a multi-level payout) — see approveDeposit. Immutable
    // once written, same as transactions.
    match /referralRewards/{id} {
      // isAdmin() deliberately comes first: the admin deposit-review UI
      // does a direct getDoc() by depositId to check whether a specific
      // purchase's commission was already paid, and that id often doesn't
      // exist (no referrer, or Rs 0 commission) — on a nonexistent
      // document `resource` is null, so `resource.data.earnerUid` would
      // throw and deny the read entirely if evaluated first. Short-circuit
      // ordering means an admin's read never touches `resource.data` at all.
      allow read: if isSignedIn() && (isAdmin() || resource.data.earnerUid == request.auth.uid);
      allow create: if isAdmin()
        && id == request.resource.data.depositId
        && request.resource.data.earnerUid is string
        && request.resource.data.earnerName is string
        && request.resource.data.sourceUid is string
        && request.resource.data.sourceName is string
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.packageId is string
        && request.resource.data.packageName is string
        && request.resource.data.packagePrice is number && request.resource.data.packagePrice > 0
        && request.resource.data.depositId is string
        && request.resource.data.status == "credited";
      allow update, delete: if false;
    }

    // One entry per (ancestor, member) pair, doc id `${ancestorUid}_${memberUid}`
    // — lets an ancestor see their own downline without a rule needing to
    // walk an arbitrary-depth referredBy chain (infeasible in Firestore
    // rules). Created either by the member themselves at signup (self-fan-out
    // from their referrer's public ancestorChain) or by an admin (used both
    // for the one-time backfill of pre-Milestone-11 signups and for keeping
    // packageId/packageName/packageExpiresAt in sync on every future
    // purchase/renewal — see team-members.ts's trust-boundary note for why
    // self-reported ancestor/level fields are safe here).
    match /teamMembers/{id} {
      allow read: if isSignedIn() && (resource.data.ancestorUid == request.auth.uid || isAdmin());
      // The self-service branch deliberately does NOT also require
      // exists(users/{memberUid}): this record is created in the SAME
      // atomic batch/transaction as the member's own users/{uid} profile
      // (see ensureUserProfile), and exists()/get() in a security rule
      // evaluates against the pre-commit server state — it does NOT see a
      // sibling document being created earlier in the very same commit
      // (verified empirically; this is true for both writeBatch and
      // runTransaction). Requiring it here would make every referral
      // signup's atomic profile-creation commit fail with permission-denied
      // every single time. request.auth.uid already IS the caller's
      // verified identity (the ID token), so no additional existence check
      // is needed for the self-service case. The admin branch keeps the
      // check: an admin write is never part of the member's own atomic
      // signup, so the target must already be a real, existing user.
      allow create: if isSignedIn()
        && request.resource.data.ancestorUid is string
        && exists(/databases/$(database)/documents/users/$(request.resource.data.ancestorUid))
        && request.resource.data.memberUid is string
        && (
          request.resource.data.memberUid == request.auth.uid
          || (isAdmin() && exists(/databases/$(database)/documents/users/$(request.resource.data.memberUid)))
        )
        && request.resource.data.memberName is string
        && request.resource.data.memberName.size() > 0
        && request.resource.data.memberEmail is string
        && request.resource.data.level is number
        && request.resource.data.level > 0
        && request.resource.data.level <= 12
        && request.resource.data.joinedAt is timestamp
        && (request.resource.data.packageId == null || request.resource.data.packageId is string)
        && (request.resource.data.packageName == null || request.resource.data.packageName is string)
        && (request.resource.data.packageExpiresAt == null || request.resource.data.packageExpiresAt is timestamp)
        && (request.resource.data.packagePrice == null || (request.resource.data.packagePrice is number && request.resource.data.packagePrice > 0))
        && (request.resource.data.packageApprovedAt == null || request.resource.data.packageApprovedAt is timestamp)
        && request.resource.data.commissionEarned is number && request.resource.data.commissionEarned >= 0;
      // Package-state and commission-reporting sync only — admin-only, and
      // only these fields, so a client can never rewrite the
      // ancestor/member/level/joinedAt identity of an existing team record.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["packageId", "packageName", "packageExpiresAt", "packagePrice", "packageApprovedAt", "commissionEarned", "updatedAt"])
        && (request.resource.data.packagePrice == null || (request.resource.data.packagePrice is number && request.resource.data.packagePrice > 0))
        && (request.resource.data.packageApprovedAt == null || request.resource.data.packageApprovedAt is timestamp)
        && request.resource.data.commissionEarned is number && request.resource.data.commissionEarned >= 0;
      allow delete: if false;
    }

    // A claim is self-service: the document itself IS the claim record, so
    // its create rule mirrors the same canClaimDaily/effectiveDailyEarning
    // checks as the users/{uid} and wallets/{uid} writes it accompanies in
    // the same client transaction. Once written, immutable — a user cannot
    // edit their own claim history.
    match /dailyRewards/{id} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.packageId == userData(request.auth.uid).package
        && request.resource.data.amount == effectiveDailyEarning(userData(request.auth.uid))
        && request.resource.data.status == "claimed"
        && request.resource.data.rewardDate is string
        && canClaimDaily(userData(request.auth.uid));
      allow update, delete: if false;
    }

    // Immutable, admin-written purchase history — the record that survives
    // "always fresh" package replacement wiping users/{uid}'s own lifecycle
    // fields on every new purchase. No durationDays/expiresAt — packages
    // never expire.
    match /packagePurchases/{id} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAdmin()
        && request.resource.data.uid is string
        && request.resource.data.packageId is string
        && request.resource.data.packageName is string
        && request.resource.data.price is number && request.resource.data.price > 0
        && request.resource.data.depositId is string
        && request.resource.data.purchasedAt is timestamp
        && request.resource.data.activatedAt is timestamp;
      allow update, delete: if false;
    }

    // Admin-managed task definitions (Milestone 12, redesigned into a
    // global-reward ad-watch model). Any signed-in user may read them
    // (needed to browse available tasks and resolve their own
    // eligibility); only an admin may write. Never deleted — disabled or
    // archived instead. No reward/frequency/proof fields anymore: every
    // task pays the single global reward (settings/taskRewards, see
    // taskRewardPerAd()) and is completed by watching its video, tracked in
    // taskCompletions — never admin-reviewed proof.
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && request.resource.data.id == taskId
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.description is string
        && request.resource.data.instructions is string
        && isValidPackageRef(request.resource.data.requiredPackageId)
        && (request.resource.data.minPackagePrice == null
            || (request.resource.data.minPackagePrice is number && request.resource.data.minPackagePrice >= 0))
        && request.resource.data.startDate is timestamp
        && (request.resource.data.endDate == null || request.resource.data.endDate is timestamp)
        && request.resource.data.videoUrl is string && request.resource.data.videoUrl.size() > 0
        && request.resource.data.status in ["active", "disabled", "archived"];
      allow update: if isAdmin()
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.description is string
        && request.resource.data.instructions is string
        && isValidPackageRef(request.resource.data.requiredPackageId)
        && (request.resource.data.minPackagePrice == null
            || (request.resource.data.minPackagePrice is number && request.resource.data.minPackagePrice >= 0))
        && request.resource.data.startDate is timestamp
        && (request.resource.data.endDate == null || request.resource.data.endDate is timestamp)
        && request.resource.data.videoUrl is string && request.resource.data.videoUrl.size() > 0
        && request.resource.data.status in ["active", "disabled", "archived"];
      allow delete: if false;
    }

    // --- Ad-task rotation + all-or-nothing daily reward ---
    // Replaces admin-reviewed taskSubmissions entirely for new activity —
    // taskSubmissions below is now read/admin-review only (create blocked),
    // and its former taskCooldowns/taskDailyCounters gating collections have
    // been removed entirely (both were empty, and nothing could ever write
    // to them again once task-submission-form.tsx was removed). Every new
    // task completion goes through taskCompletions instead.

    // One document per (uid, taskId), doc id `${uid}_${taskId}`, reused
    // across every calendar day — see task-completions.ts for the full
    // two-phase (Start/Complete) lifecycle this enforces. taskEligible()
    // covers the same package-gate check tasks/{taskId} itself uses.
    match /taskCompletions/{id} {
      // resource == null must be allowed here — startTaskWatch's transaction
      // always reads this document first to check whether it exists yet
      // (the check-then-create/reset idiom), and for a task a user has never
      // started, resource is null: resource.data.uid would throw a
      // null-dereference evaluation error (treated as deny) on literally the
      // first Start of every task, for every user — the same pitfall
      // pendingBonusClaims's read rule already documents and guards against.
      allow read: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isActiveAccount(request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + "_" + request.resource.data.taskId
        && taskEligible(request.auth.uid, request.resource.data.taskId)
        && request.resource.data.startedAt == request.time
        && request.resource.data.completedAt == null;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.taskId == resource.data.taskId
        && (
          // Re-Start for a new UTC day (the previous completion is stale).
          (resource.data.completedAt != null
            && isNewUtcDay(resource.data.completedAt, request.time)
            && request.resource.data.startedAt == request.time
            && request.resource.data.completedAt == null)
          // Complete today's Start — the one real anti-instant-click floor:
          // at least 10 real wall-clock seconds since startedAt. Task
          // eligibility is deliberately NOT re-checked here — if a task
          // goes inactive mid-watch, no reward is owed for it, which is
          // correct, not a bug.
          || (resource.data.completedAt == null
            && request.time >= resource.data.startedAt + duration.value(10, "s")
            && request.resource.data.startedAt == resource.data.startedAt
            && request.resource.data.completedAt == request.time)
        );
      allow delete: if false;
    }

    // One document per user (doc id == uid) — counts how many DISTINCT
    // tasks this user has completed TODAY (a real UTC calendar day),
    // against effectiveDailyTaskLimit(). Incremented by exactly 1 in the
    // SAME transaction as a taskCompletions Complete-transition; since a
    // given task can only complete once per day (see above), double-
    // counting one task toward this count is impossible by construction.
    match /dailyTaskProgress/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.count == 1
        && request.resource.data.windowStartAt == request.time;
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && (
          (isNewUtcDay(resource.data.windowStartAt, request.time)
            && request.resource.data.count == 1
            && request.resource.data.windowStartAt == request.time)
          || (!isNewUtcDay(resource.data.windowStartAt, request.time)
            && request.resource.data.count == resource.data.count + 1
            && request.resource.data.windowStartAt == resource.data.windowStartAt)
        );
      allow delete: if false;
    }

    // One document per user (doc id == uid) — the day-to-day "which ads are
    // offered today" rotation/cycle state. Deliberately NOT part of the
    // financial trust boundary: only light shape validation here, and no
    // money-moving rule anywhere in this file ever reads this document.
    // Tampering with your own rotation state can only change which tasks
    // you personally see next — the actual reward gate above independently
    // re-derives truth from real taskCompletions/dailyTaskProgress
    // documents, never from these self-reported arrays.
    match /taskRotations/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.cycleId is number && request.resource.data.cycleId >= 1
        && request.resource.data.remainingPoolTaskIds is list
        && request.resource.data.completedThisCycleTaskIds is list
        && request.resource.data.assignedDate is string
        && request.resource.data.assignedTaskIds is list
        && request.resource.data.assignedTaskIds.size() <= 50;
      allow delete: if false;
    }

    // --- Legacy admin-reviewed task submissions (frozen, see above) ---

    // Read-only historical/admin-review surface now: creation is
    // permanently blocked (the only client that ever wrote here,
    // task-submission-form.tsx, was removed when the task system moved to
    // the global-reward/video-completion model above — see taskCompletions).
    // The collection is empty in production as of this cleanup; read +
    // admin-review (approve/reject) access is kept only so the admin Task
    // Submissions page keeps working as a frozen view of any pre-migration
    // history, without a code path that could ever add to it again. The
    // sibling taskCooldowns/taskDailyCounters collections that used to gate
    // new submissions here have been removed entirely (see below) since
    // nothing can ever create one again either.
    match /taskSubmissions/{id} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if false;
      allow update: if isAdmin() && adminCanReviewRequest();
      allow delete: if false;
    }

    // Admin-managed salary/level bonus tier definitions (Milestone 12). No
    // tier is seeded by default — every threshold and the bonus amount
    // itself is admin-entered, never hardcoded. Any signed-in user may read
    // them (needed to show progress toward not-yet-met tiers).
    match /bonusTiers/{tierId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && request.resource.data.id == tierId
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.requiredDirectReferrals is number && request.resource.data.requiredDirectReferrals >= 0
        && request.resource.data.requiredTotalTeam is number && request.resource.data.requiredTotalTeam >= 0
        && request.resource.data.requiredActiveTeam is number && request.resource.data.requiredActiveTeam >= 0
        && isValidPackageRef(request.resource.data.requiredPackageId)
        && request.resource.data.bonusAmount is number && request.resource.data.bonusAmount > 0
        && request.resource.data.recurrence in ["one_time", "recurring"]
        && request.resource.data.isActive is bool;
      allow update: if isAdmin()
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.requiredDirectReferrals is number && request.resource.data.requiredDirectReferrals >= 0
        && request.resource.data.requiredTotalTeam is number && request.resource.data.requiredTotalTeam >= 0
        && request.resource.data.requiredActiveTeam is number && request.resource.data.requiredActiveTeam >= 0
        && isValidPackageRef(request.resource.data.requiredPackageId)
        && request.resource.data.bonusAmount is number && request.resource.data.bonusAmount > 0
        && request.resource.data.recurrence in ["one_time", "recurring"]
        && request.resource.data.isActive is bool;
      allow delete: if false;
    }

    // A user's self-submitted bonus claim. directReferralsAtClaim/
    // totalTeamAtClaim/activeTeamAtClaim are client-reported and checked here
    // only for basic shape and for meeting the tier's own thresholds — NOT
    // proof the numbers are real, since Firestore rules cannot run the
    // aggregate queries needed to verify a team count. The actual
    // authoritative eligibility check happens in approveBonusClaim, which
    // re-fetches the claimant's live team aggregates before crediting
    // anything (see features/admin/lib/bonus-actions.ts). Duplicate
    // one-time payment is prevented at approval time via bonusAwards, not
    // here — this only stops piling up new claims once one is already paid.
    // A second, independent guard — !exists(pendingBonusClaims/{uid}_{tierId})
    // below — blocks a second PENDING claim for the same tier from ever being
    // created (recurring tiers have no bonusAwards-style permanent marker, so
    // without this, nothing else stops one being piled up); see the
    // pendingBonusClaims match block just below for the full explanation.
    match /bonusClaims/{id} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isActiveAccount(request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userName is string && request.resource.data.userName.size() > 0
        && request.resource.data.tierId is string
        && get(/databases/$(database)/documents/bonusTiers/$(request.resource.data.tierId)).data.isActive == true
        && request.resource.data.tierName == get(/databases/$(database)/documents/bonusTiers/$(request.resource.data.tierId)).data.name
        && request.resource.data.bonusAmount == get(/databases/$(database)/documents/bonusTiers/$(request.resource.data.tierId)).data.bonusAmount
        && request.resource.data.recurrence == get(/databases/$(database)/documents/bonusTiers/$(request.resource.data.tierId)).data.recurrence
        && request.resource.data.directReferralsAtClaim is number
        && request.resource.data.directReferralsAtClaim >= get(/databases/$(database)/documents/bonusTiers/$(request.resource.data.tierId)).data.requiredDirectReferrals
        && request.resource.data.totalTeamAtClaim is number
        && request.resource.data.totalTeamAtClaim >= get(/databases/$(database)/documents/bonusTiers/$(request.resource.data.tierId)).data.requiredTotalTeam
        && request.resource.data.activeTeamAtClaim is number
        && request.resource.data.activeTeamAtClaim >= get(/databases/$(database)/documents/bonusTiers/$(request.resource.data.tierId)).data.requiredActiveTeam
        && bonusPackageEligible(request.auth.uid, request.resource.data.tierId)
        && (request.resource.data.packageIdAtClaim == null || request.resource.data.packageIdAtClaim is string)
        && (get(/databases/$(database)/documents/bonusTiers/$(request.resource.data.tierId)).data.recurrence == "recurring"
            || !exists(/databases/$(database)/documents/bonusAwards/$(request.auth.uid + "_" + request.resource.data.tierId)))
        && !exists(/databases/$(database)/documents/pendingBonusClaims/$(request.auth.uid + "_" + request.resource.data.tierId))
        && request.resource.data.status == "pending"
        && request.resource.data.reviewedBy == null;
      allow update: if isAdmin() && adminCanReviewRequest();
      allow delete: if false;
    }

    // The actual "never pay the same one-time bonus twice" guarantee: one
    // doc per (uid, tierId), doc id `${uid}_${tierId}`, created only by
    // approveBonusClaim inside the same transaction that credits the
    // wallet, only for "one_time" tiers. Its existence alone is checked
    // (via a direct transaction.get, not a query) before any future
    // one-time claim for that tier can even be approved.
    match /bonusAwards/{id} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAdmin()
        && id == request.resource.data.uid + "_" + request.resource.data.tierId
        && request.resource.data.uid is string
        && request.resource.data.tierId is string
        && request.resource.data.claimId is string
        && request.resource.data.amount is number && request.resource.data.amount > 0;
      allow update, delete: if false;
    }

    // One-doc-per-(uid, tierId) pending-claim lock, id `${uid}_${tierId}` —
    // the SAME "resource == null means it doesn't exist yet, so `create`
    // alone enforces exclusivity" trick bonusAwards already uses, applied to
    // a TEMPORARY marker instead of a permanent one. submitBonusClaim
    // creates this in the same client transaction as the bonusClaims doc
    // itself; approveBonusClaim/rejectBonusClaim delete it in the same
    // transaction that resolves the claim, which is what lets a user submit
    // a legitimate new claim for a recurring tier again once this one has
    // been reviewed — this rule only ever blocks a SECOND simultaneous
    // PENDING claim for the same tier, never a later, separate one.
    match /pendingBonusClaims/{id} {
      // resource == null must be allowed here (not just resource.data.uid
      // matching): submitBonusClaim's transaction.get() on this ref is how
      // it checks whether a lock ALREADY exists, and that read happens
      // before the doc has ever been created — resource.data would throw a
      // null-dereference evaluation error (treated as deny) for every
      // FIRST-ever claim on a tier otherwise. The only information this
      // exposes is whether some uid+tierId combination currently has a
      // pending claim (a boolean), never the claim's own data.
      allow read: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isActiveAccount(request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tierId is string && request.resource.data.tierId.size() > 0
        && id == request.auth.uid + "_" + request.resource.data.tierId
        && request.resource.data.claimId is string && request.resource.data.claimId.size() > 0;
      allow update: if false;
      // Deleting this lock has no direct financial effect by itself — it
      // only ever re-opens the ability to submit a NEW claim for this tier.
      // The actual money-safety guarantees (eligibility re-check, one-time
      // bonusAwards marker) live entirely in approveBonusClaim, so no extra
      // condition is needed here beyond admin-only.
      allow delete: if isAdmin();
    }

    // The admin-authored notification broadcast content (Milestone 13) — one
    // doc per "send" action. Any signed-in user may read the list (needed
    // for admin history and, in principle, transparency); only an admin may
    // create one. Update is intentionally narrow: only isActive can be
    // toggled (a soft-retract), never the audience or content after the
    // fact — the actual fan-out to recipients (userNotifications below) is
    // a separate, immutable, already-delivered record.
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.body is string && request.resource.data.body.size() > 0
        && request.resource.data.isActive == true
        && request.resource.data.audienceType in ["all", "active_package", "selected"]
        && request.resource.data.selectedUids is list
        && request.resource.data.recipientCount is number && request.resource.data.recipientCount >= 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName is string;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isActive", "updatedAt"])
        && request.resource.data.isActive is bool;
      allow delete: if false;
    }

    // Two shapes in one collection: an admin broadcast ("announcement",
    // doc id `${announcementId}_${uid}` — deterministic so a re-run fan-out
    // can never double-deliver the same broadcast to the same user), or a
    // system-generated transactional notification about the recipient's own
    // deposit/withdrawal/task submission status change (auto-id, written
    // only inside the same atomic transaction that made the change — see
    // deposit-actions.ts/withdrawal-actions.ts/task-actions.ts). Either way,
    // only an admin-run action ever creates one; the recipient may only
    // ever flip their own `read`/`readAt`, nothing else (identity/content is
    // frozen).
    match /userNotifications/{id} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAdmin()
        && request.resource.data.uid is string
        && exists(/databases/$(database)/documents/users/$(request.resource.data.uid))
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.read == false
        && request.resource.data.readAt == null
        && (
             (request.resource.data.kind == "announcement"
               && id == request.resource.data.announcementId + "_" + request.resource.data.uid
               && request.resource.data.announcementId is string
               && exists(/databases/$(database)/documents/announcements/$(request.resource.data.announcementId)))
             || (request.resource.data.kind in ["deposit", "withdrawal", "task_submission", "admin_adjustment", "account_status"]
               && request.resource.data.announcementId == null)
           );
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read", "readAt"])
        && request.resource.data.read == true
        && request.resource.data.readAt == request.time;
      allow delete: if false;
    }

    // Package definitions (price, daily earning, daily task limit, flat
    // referral commission, features, active status) are fully admin-managed.
    // Packages never expire once purchased — there is no duration field;
    // a package only stops qualifying a user once an admin disables it
    // (isActive: false) or the user is assigned a different one. Any
    // signed-in user may read them to know their own limits or browse
    // purchasable packages. Packages are disabled (isActive: false), never
    // deleted, so users already assigned to one never point at a missing
    // document.
    match /packages/{packageId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && request.resource.data.id == packageId
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.price is number && request.resource.data.price > 0
        && request.resource.data.dailyEarning is number && request.resource.data.dailyEarning >= 0
        && request.resource.data.referralCommission is number && request.resource.data.referralCommission >= 0
        && request.resource.data.dailyTaskLimit is number && request.resource.data.dailyTaskLimit >= 0
        && request.resource.data.features is list
        && request.resource.data.isActive is bool;
      allow update: if isAdmin()
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.price is number && request.resource.data.price > 0
        && request.resource.data.dailyEarning is number && request.resource.data.dailyEarning >= 0
        && request.resource.data.referralCommission is number && request.resource.data.referralCommission >= 0
        && request.resource.data.dailyTaskLimit is number && request.resource.data.dailyTaskLimit >= 0
        && request.resource.data.features is list
        && request.resource.data.isActive is bool;
      // Permanent delete is admin-only in the rules layer, not just hidden
      // in the UI. Client-side safety checks (no assigned users, no pending
      // deposits referencing this package) live in deletePackageAction —
      // rules cannot run collection-wide queries to enforce that here, only
      // gate who is allowed to attempt the write at all.
      allow delete: if isAdmin();
    }

    // Append-only admin audit trail. Never client-editable, never deletable.
    match /activityLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string && request.resource.data.action.size() > 0
        && request.resource.data.targetType is string
        && request.resource.data.targetId is string
        && request.resource.data.details is string;
      allow update, delete: if false;
    }

    // Singleton global config docs (e.g. the daily-claims kill switch, the
    // Official Channel links/banner). Any signed-in user may read; only an
    // admin may write. Each known doc id validates its own shape — this
    // stays a single match block (rather than one per doc) since Firestore
    // rules match on collection path, not individual document ids.
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && (
        (settingId == "global" && request.resource.data.dailyClaimsEnabled is bool)
        || (settingId == "officialChannel"
          && (request.resource.data.telegramUrl == null || request.resource.data.telegramUrl is string)
          && (request.resource.data.whatsappUrl == null || request.resource.data.whatsappUrl is string)
          && (request.resource.data.youtubeUrl == null || request.resource.data.youtubeUrl is string)
          && (request.resource.data.websiteUrl == null || request.resource.data.websiteUrl is string)
          && (request.resource.data.bannerImageUrl == null || request.resource.data.bannerImageUrl is string)
          && (request.resource.data.bannerText == null || request.resource.data.bannerText is string)
          && (request.resource.data.contactEmail == null || request.resource.data.contactEmail is string)
          && (request.resource.data.contactPhone == null || request.resource.data.contactPhone is string)
          && (request.resource.data.contactAddress == null || request.resource.data.contactAddress is string))
        || (settingId == "withdrawalRules"
          && request.resource.data.currentBalanceMinWithdraw is number && request.resource.data.currentBalanceMinWithdraw >= 0
          && request.resource.data.cocaColaRequiredLevel is number && request.resource.data.cocaColaRequiredLevel >= 0)
        || (settingId == "paymentDetails"
          && request.resource.data.accountTitle is string && request.resource.data.accountTitle.size() > 0
          && request.resource.data.accountNumber is string && request.resource.data.accountNumber.size() > 0)
        || (settingId == "taskRewards"
          && request.resource.data.rewardPerAd is number && request.resource.data.rewardPerAd > 0)
      );
    }

    // --- Milestone 16: Website Content Management System ---
    // Every CMS collection below follows the same shape: any signed-in OR
    // anonymous visitor may read published content (allow read is split
    // into two conditions since public marketing pages are visitor-facing
    // and must not require sign-in), only an admin may write, and — unlike
    // every financial collection in this file — real deletion is allowed,
    // since marketing/informational content carries no audit/money
    // integrity requirement the way deposits or referral rewards do.
    // "isPublished" gates visibility; list/query-shaped reads for the
    // public must explicitly filter on it themselves (see cms-*.ts) since
    // Firestore rules cannot partially filter an unfiltered list request.

    function cmsContentTypeIsValid(type) {
      return type in [
        "hero", "rich_text", "image_text", "cards_grid", "faq",
        "contact_block", "cta", "banner", "video", "document", "social_links"
      ];
    }

    // Admin-authored custom pages (About Us, Contact Us, Privacy Policy,
    // Terms, Promotions, News, Offers, or any informational page), rendered
    // publicly at /p/{slug}.
    match /cmsPages/{id} {
      allow read: if isAdmin() || resource.data.isPublished == true;
      allow create: if isAdmin()
        && request.resource.data.id == id
        && request.resource.data.slug is string && request.resource.data.slug.size() > 0
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && (request.resource.data.metaDescription == null || request.resource.data.metaDescription is string)
        && request.resource.data.isPublished is bool;
      allow update: if isAdmin()
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.slug is string && request.resource.data.slug.size() > 0
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && (request.resource.data.metaDescription == null || request.resource.data.metaDescription is string)
        && request.resource.data.isPublished is bool;
      allow delete: if isAdmin();
    }

    // Ordered content blocks belonging to a cmsPages/{pageId} document. No
    // "custom_html" type exists in cmsContentTypeIsValid — raw markup can
    // never be stored here, let alone rendered.
    match /cmsSections/{id} {
      allow read: if isAdmin() || resource.data.isPublished == true;
      allow create: if isAdmin()
        && request.resource.data.id == id
        && request.resource.data.pageId is string
        && exists(/databases/$(database)/documents/cmsPages/$(request.resource.data.pageId))
        && cmsContentTypeIsValid(request.resource.data.type)
        && (request.resource.data.title == null || request.resource.data.title is string)
        && (request.resource.data.subtitle == null || request.resource.data.subtitle is string)
        && (request.resource.data.description == null || request.resource.data.description is string)
        && (request.resource.data.richText == null || request.resource.data.richText is string)
        && (request.resource.data.mediaUrl == null || request.resource.data.mediaUrl is string)
        && (request.resource.data.buttonLabel == null || request.resource.data.buttonLabel is string)
        && (request.resource.data.buttonUrl == null || request.resource.data.buttonUrl is string)
        && request.resource.data.items is list
        && request.resource.data.order is number
        && request.resource.data.isPublished is bool
        && (request.resource.data.startDate == null || request.resource.data.startDate is timestamp)
        && (request.resource.data.endDate == null || request.resource.data.endDate is timestamp);
      allow update: if isAdmin()
        && request.resource.data.id == resource.data.id
        && request.resource.data.pageId == resource.data.pageId
        && request.resource.data.createdAt == resource.data.createdAt
        && cmsContentTypeIsValid(request.resource.data.type)
        && (request.resource.data.title == null || request.resource.data.title is string)
        && (request.resource.data.subtitle == null || request.resource.data.subtitle is string)
        && (request.resource.data.description == null || request.resource.data.description is string)
        && (request.resource.data.richText == null || request.resource.data.richText is string)
        && (request.resource.data.mediaUrl == null || request.resource.data.mediaUrl is string)
        && (request.resource.data.buttonLabel == null || request.resource.data.buttonLabel is string)
        && (request.resource.data.buttonUrl == null || request.resource.data.buttonUrl is string)
        && request.resource.data.items is list
        && request.resource.data.order is number
        && request.resource.data.isPublished is bool
        && (request.resource.data.startDate == null || request.resource.data.startDate is timestamp)
        && (request.resource.data.endDate == null || request.resource.data.endDate is timestamp);
      allow delete: if isAdmin();
    }

    // Site-wide public announcement banners — distinct from the personal,
    // per-user notification inbox (userNotifications above).
    match /cmsAnnouncements/{id} {
      allow read: if isAdmin() || resource.data.isPublished == true;
      allow create: if isAdmin()
        && request.resource.data.id == id
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.message is string && request.resource.data.message.size() > 0
        && (request.resource.data.buttonLabel == null || request.resource.data.buttonLabel is string)
        && (request.resource.data.buttonUrl == null || request.resource.data.buttonUrl is string)
        && request.resource.data.order is number
        && request.resource.data.isPublished is bool
        && (request.resource.data.startDate == null || request.resource.data.startDate is timestamp)
        && (request.resource.data.endDate == null || request.resource.data.endDate is timestamp);
      allow update: if isAdmin()
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.message is string && request.resource.data.message.size() > 0
        && (request.resource.data.buttonLabel == null || request.resource.data.buttonLabel is string)
        && (request.resource.data.buttonUrl == null || request.resource.data.buttonUrl is string)
        && request.resource.data.order is number
        && request.resource.data.isPublished is bool
        && (request.resource.data.startDate == null || request.resource.data.startDate is timestamp)
        && (request.resource.data.endDate == null || request.resource.data.endDate is timestamp);
      allow delete: if isAdmin();
    }

    // Feeds both the public landing page's FAQ section and the Guide & Help
    // Center's FAQ tab — one source of truth (replaces the Milestone 13
    // hardcoded FAQ_ITEMS).
    match /cmsFaqItems/{id} {
      allow read: if isAdmin() || resource.data.isPublished == true;
      allow create: if isAdmin()
        && request.resource.data.id == id
        && request.resource.data.question is string && request.resource.data.question.size() > 0
        && request.resource.data.answer is string && request.resource.data.answer.size() > 0
        && request.resource.data.order is number
        && request.resource.data.isPublished is bool;
      allow update: if isAdmin()
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.question is string && request.resource.data.question.size() > 0
        && request.resource.data.answer is string && request.resource.data.answer.size() > 0
        && request.resource.data.order is number
        && request.resource.data.isPublished is bool;
      allow delete: if isAdmin();
    }

    // Feeds the Guide & Help Center (replaces the Milestone 13 hardcoded
    // DEPOSIT_GUIDE/WITHDRAWAL_GUIDE/REFERRAL_GUIDE/PACKAGE_GUIDE arrays).
    match /cmsGuideSteps/{id} {
      allow read: if isAdmin() || resource.data.isPublished == true;
      allow create: if isAdmin()
        && request.resource.data.id == id
        && request.resource.data.category in ["deposit", "withdrawal", "referral", "package"]
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.body is string && request.resource.data.body.size() > 0
        && request.resource.data.order is number
        && request.resource.data.isPublished is bool;
      allow update: if isAdmin()
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.category in ["deposit", "withdrawal", "referral", "package"]
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.body is string && request.resource.data.body.size() > 0
        && request.resource.data.order is number
        && request.resource.data.isPublished is bool;
      allow delete: if isAdmin();
    }

    // Feeds the Guide & Help Center's Rules tab (replaces the Milestone 13
    // hardcoded PLATFORM_RULES array).
    match /cmsRules/{id} {
      allow read: if isAdmin() || resource.data.isPublished == true;
      allow create: if isAdmin()
        && request.resource.data.id == id
        && request.resource.data.text is string && request.resource.data.text.size() > 0
        && request.resource.data.order is number
        && request.resource.data.isPublished is bool;
      allow update: if isAdmin()
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.text is string && request.resource.data.text.size() > 0
        && request.resource.data.order is number
        && request.resource.data.isPublished is bool;
      allow delete: if isAdmin();
    }

    // Header navigation and footer content (replaces the hardcoded
    // NAV_LINKS/LEGAL_LINKS/SUPPORT_LINKS constants).
    match /cmsLinks/{id} {
      allow read: if isAdmin() || resource.data.isPublished == true;
      allow create: if isAdmin()
        && request.resource.data.id == id
        && request.resource.data.placement in ["header", "footer_nav", "footer_legal", "footer_support"]
        && request.resource.data.label is string && request.resource.data.label.size() > 0
        && request.resource.data.url is string && request.resource.data.url.size() > 0
        && request.resource.data.order is number
        && request.resource.data.isPublished is bool;
      allow update: if isAdmin()
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.placement in ["header", "footer_nav", "footer_legal", "footer_support"]
        && request.resource.data.label is string && request.resource.data.label.size() > 0
        && request.resource.data.url is string && request.resource.data.url.size() > 0
        && request.resource.data.order is number
        && request.resource.data.isPublished is bool;
      allow delete: if isAdmin();
    }

    // An admin-only reference library of vetted external media URLs for
    // reuse when building sections — never rendered directly to the public,
    // so unlike the other CMS collections above, this one has no public
    // read path at all.
    match /cmsMedia/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.id == id
        && request.resource.data.label is string && request.resource.data.label.size() > 0
        && request.resource.data.url is string && request.resource.data.url.size() > 0
        && request.resource.data.type in ["image", "video", "document"];
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
